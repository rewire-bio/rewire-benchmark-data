export const PROMPT_PATH: string;
export const FIXTURES: string;
export const ORG: string;
export const SITE: string;
export const ASSIGNEE: string;
export const LEAD_LABELS: string[];
export const MODELS: { explain: string };
export const LIMITS: Record<string, number>;
export const MARKERS: Record<'lead' | 'listed' | 'rose' | 'refired' | 'gone', string>;
export const NOT_RECORDED: string;
export type Finding = Record<string, any>;
export type Lead = { finding: Finding; reason: 'new' | 'rose' | 'refired'; from?: string };
export type Diff = { added: Finding[]; rose: { finding: Finding; from: string }[]; refired: Finding[]; gone: { finding: Finding; resolved: boolean; state: string | null }[]; priorIds?: Map<string, string[]>; rulesChanged: { from: string | null; to: string | null } | null };
export type Plan = { file: Lead[]; overflow: Lead[]; comments: { number: number; marker: string; body: string }[]; skipped: { id: string; reason: string }[] };
export type IssueText = { title: string; body: string; labels: string[]; assignees: string[] };
export function keySignature(finding: Finding): string | null;
export function diffReleases(previous: any, current: any): Diff;
export function knownLeads(issues: any[]): Map<string, { number: number; state?: string; html_url?: string; how: string }[]>;
export function planRun(diff: Diff, opts: { issues: any[]; release: string; maxIssues?: number }): Plan;
export function idsNeeded(findings: Finding[]): Set<string>;
export function readRecords(path: string, ids: Set<string>): Promise<Map<string, any>>;
export function studyLabel(study: any, records: Map<string, any>, repeated?: Set<string>): { name: string; url: string | null; text: string };
export function findingTier(finding: Finding, records: Map<string, any>): number | null;
export function fmt(v: unknown): string;
export function protocolFacts(finding: Finding, records: Map<string, any>): any[];
export function explanationFacts(finding: Finding, records: Map<string, any>): any;
export function renderLead(lead: Lead, opts: { records: Map<string, any>; release: string; previous: string; explanation: string | null; explanationNote: string | null; runUrl?: string }): IssueText;
export function renderOverflow(leads: Lead[], opts: { records: Map<string, any>; release: string; previous: string; filedCount: number; runUrl?: string }): IssueText;
export function checkExplanation(text: string, facts: any): { ok: true; text: string } | { ok: false; why: string; stray?: string[] };
export function explain(client: any, usage: any, opts: { system: string; facts: any; log?: (m: string) => void }): Promise<{ text: string | null; note: string | null }>;
export function watcherGithub(token: string, fetchImpl?: typeof fetch): any;
export function renderSummary(input: any): string;
export function main(argv?: string[], env?: Record<string, string | undefined>, deps?: Record<string, any>): Promise<any>;
