{
  "name": "@rewire-bio/benchmark-data",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run omics:release && npm run kg -- export && node scripts/parallel.mjs kg:build serving && npm run validate:benchmark-literature && npm run export:benchmark-literature && npm run refresh -- export && node scripts/package-website.mjs --current-only",
    "build:check": "npm run omics:release && npm run kg -- export && npm run serving && npm run validate:benchmark-literature && npm run export:benchmark-literature && npm run refresh -- export && node scripts/package-website.mjs --current-only",
    "omics:release": "tsx scripts/omics/release.ts",
    "validate:benchmark-literature": "node scripts/validate-benchmark-literature.mjs",
    "export:benchmark-literature": "node scripts/export-benchmark-literature.mjs",
    "test": "vitest run",
    "test:fast": "TEST_SCOPE=fast vitest run",
    "typecheck": "tsc --noEmit",
    "test:python": "python3 -m unittest discover -s scripts/omics/tests -p \"test_*.py\"",
    "verify:package": "node scripts/verify-package-tracking.mjs",
    "refresh": "tsx scripts/refresh/cli.ts",
    "omics:check-updates": "tsx scripts/omics/check-updates.ts",
    "records": "tsx scripts/omics/records.ts",
    "vocab:migrate": "tsx scripts/omics/migrate-vocab.ts",
    "use-cases:migrate": "tsx scripts/omics/migrate-use-cases.ts",
    "relations:migrate": "tsx scripts/omics/migrate-relations.ts",
    "records:correct": "tsx scripts/omics/apply-corrections.ts",
    "use-cases:repin": "tsx scripts/omics/repin-use-cases.ts",
    "attributes:migrate": "tsx scripts/omics/migrate-attributes.ts",
    "release:prune": "tsx scripts/omics/prune-releases.ts",
    "identity:candidates": "tsx scripts/omics/identity-candidates.ts",
    "kg": "tsx scripts/kg/export.ts",
    "kg:build": "uv run --quiet --no-project --python 3.12 --with-requirements scripts/kg/requirements.txt python scripts/kg/build.py",
    "kg:shapes": "npm run -s kg -- export && npm run -s kg:build -- --shapes-only",
    "kg:publish": "tsx scripts/kg/publish.ts",
    "kg:verify": "uvx --from ${RDF_KG_MCP:-git+https://github.com/rewire-bio/rdf-kg-mcp@v0.1.0} rdf-kg-mcp verify public/kg",
    "test:kg": "uv run --quiet --no-project --python 3.12 --with-requirements scripts/kg/requirements.txt python -m unittest discover -s scripts/kg/tests -p \"test_*.py\"",
    "serving": "tsx scripts/serving/sqlite.ts",
    "serving:parity": "tsx scripts/serving/parity.ts",
    "serving:publish": "tsx scripts/serving/publish.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/n3": "1.16.4",
    "@types/node": "24.3.0",
    "fast-xml-parser": "^5.11.1",
    "jsonld": "8.3.3",
    "n3": "1.17.4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^1.0.4"
  }
}
