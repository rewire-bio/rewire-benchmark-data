# SHACL shapes the knowledge-graph build checks against the asserted and inferred graphs together.
# A violation fails the build. They encode what the release validation already guarantees, plus
# the guarantees the inferred links must keep (one system, one assessment and one dataset per
# result). Changes are reviewed like record changes.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix rbs: <https://benchmarks.rewire.it/shapes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

rbs:Record a sh:NodeShape ;
    sh:targetSubjectsOf rb:status ;
    rdfs:comment "Every exported record has one label and one public status. Excluded records never enter the graph." ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    ] , [
        sh:path rb:status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:not [ sh:hasValue <https://benchmarks.rewire.it/vocab/status/excluded> ] ;
    ] .

rbs:TestedLinks a sh:NodeShape ;
    sh:targetSubjectsOf rb:testedSystem, rb:testedOn ;
    rdfs:comment "Only evaluations test a system or use an assessment. A typed subject or assessment link on any other kind of record must get its own property in the mapping." ;
    sh:class rb:Evaluation .

rbs:Review a sh:NodeShape ;
    sh:targetSubjectsOf rb:reviewDate, rb:reviewedAt ;
    rdfs:comment "One review date and one review time at most, each correctly typed." ;
    sh:property [
        sh:path rb:reviewDate ; sh:maxCount 1 ; sh:datatype xsd:date ;
    ] , [
        sh:path rb:reviewedAt ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:date ] ) ;
    ] .

rbs:Evaluation a sh:NodeShape ;
    sh:targetClass rb:Evaluation ;
    rdfs:comment "An evaluation tests exactly one system, under one assessment, on one dataset." ;
    sh:property [
        sh:path rb:testedSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:System ;
    ] , [
        sh:path rb:testedOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Assessment ;
    ] , [
        sh:path rb:dataset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Dataset ;
    ] .

rbs:Result a sh:NodeShape ;
    sh:targetClass rb:Result ;
    rdfs:comment "A result belongs to one evaluation, reports one metric and printed value, and is sourced. Its inferred links point to exactly one system, assessment and dataset." ;
    sh:property [
        sh:path rb:evaluation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Evaluation ;
    ] , [
        sh:path rb:metric ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path rb:printedValue ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path rb:unit ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path rb:metricDirection ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path mls:hasValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
    ] , [
        sh:path dcterms:source ; sh:minCount 1 ;
    ] , [
        sh:path rb:resultFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:System ;
    ] , [
        sh:path rb:resultOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Assessment ;
    ] , [
        sh:path rb:resultOnDataset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Dataset ;
    ] .

rbs:Claim a sh:NodeShape ;
    sh:targetClass rb:Claim ;
    rdfs:comment "A claim is about at least one record and cites at least one source." ;
    sh:property [
        sh:path rb:subject ; sh:minCount 1 ;
    ] , [
        sh:path dcterms:source ; sh:minCount 1 ;
    ] .

rbs:Source a sh:NodeShape ;
    sh:targetClass rb:Source ;
    rdfs:comment "A source has at most one artifact checksum, as 64 hex characters, and one typed retrieval date." ;
    sh:property [
        sh:path rb:retrievedAt ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:date ] ) ;
    ] , [
        sh:path rb:artifactSha256 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ;
    ] .

# Controlled values: every value of these properties is a concept of the named scheme in
# data/vocab/. The build mixes the schemes into the data graph for this check.

rbs:StatusConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:status ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/status/> ; sh:minCount 1 ] .

rbs:AreaConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:area ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/area/> ; sh:minCount 1 ] .

rbs:MethodTypeConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:methodType ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/method-type/> ; sh:minCount 1 ] .

rbs:ContextConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:context ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/context/> ; sh:minCount 1 ] .

rbs:EntityLevelConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:entityLevel ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/entity-level/> ; sh:minCount 1 ] .

rbs:PublicationStatusConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:publicationStatus ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/publication-status/> ; sh:minCount 1 ] .

rbs:OriginConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:origin ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/origin/> ; sh:minCount 1 ] .

rbs:BaselineTypeConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:baselineType ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/baseline-type/> ; sh:minCount 1 ] .

rbs:ConfigurationTypeConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:configurationType ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/configuration-type/> ; sh:minCount 1 ] .

rbs:MetricConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:metric ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/metric/> ; sh:minCount 1 ] .

rbs:UnitConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:unit ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/unit/> ; sh:minCount 1 ] .

rbs:MetricDirectionConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:metricDirection ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/direction/> ; sh:minCount 1 ] .

rbs:DefaultDirectionConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:defaultDirection ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/direction/> ; sh:minCount 1 ] .

rbs:ReviewMethodConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:reviewMethod ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/review-method/> ; sh:minCount 1 ] .

rbs:ReviewedByConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:reviewedBy ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/agent/> ; sh:minCount 1 ] .

rbs:BaselineAlgorithmConcept a sh:NodeShape ;
    sh:targetObjectsOf rb:baselineAlgorithm ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/algorithm/> ; sh:minCount 1 ] .
