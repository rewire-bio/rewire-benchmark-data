# Rewire benchmark vocabulary: the classes and properties used by data/ontology/mapping.json,
# with the axioms the knowledge-graph build reasons over (OWL 2 RL).
#
# Rules this file must keep (checked by scripts/kg/tests):
# - No owl:sameAs, and rb:aliasOf is neither symmetric nor transitive: aliases never merge records.
# - rb:testedSystem, rb:testedOn, rb:dataset, rb:evaluation and mls:hasValue are asserted only:
#   nothing is a subproperty of them and they are never inferred. Results attach only to what
#   was actually evaluated.
# - Every relation has one meaning (shared/omics/relations.ts), so no axiom here has to
#   account for links that mean different things on different kinds of record.
# - rb:usesModel, rb:family, rb:variantOf and rb:configurationOf are not transitive, not
#   subproperties of rb:testedSystem and not part of any property chain: a pipeline's or
#   variant's result is never a result of the model it uses or belongs to.
# - No rdfs:domain or rdfs:range on rb: properties, so no record gets a type from a link.
# - Discrepancy terms appear only in the derived graph, which the reasoner never reads, and
#   no record property is a subproperty of them.
# Changes to this file are reviewed like record changes.

@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix schema: <https://schema.org/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<https://benchmarks.rewire.it/vocab> a owl:Ontology ;
    dcterms:title "Rewire benchmark vocabulary" ;
    dcterms:description "Classes and properties for reviewed biological benchmark records: what was evaluated, on what, with which data, the reported results and their sources." ;
    owl:versionInfo "1.0" ;
    rdfs:seeAlso <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/docs/linked-data.md> .

# Classes ---------------------------------------------------------------------------------

rb:System a owl:Class ;
    rdfs:label "system" ;
    rdfs:comment "Something an evaluation can test: a method, model, configuration, pipeline or service." .

rb:Assessment a owl:Class ;
    rdfs:label "assessment" ;
    rdfs:comment "What an evaluation is measured against: a benchmark, task or protocol." .

rb:Method a owl:Class ; rdfs:subClassOf mls:Algorithm, rb:System ;
    rdfs:label "method" ;
    rdfs:comment "An algorithm or scientific procedure, independent of a trained artifact." .

rb:Model a owl:Class ; rdfs:subClassOf rb:System ;
    rdfs:label "model" ;
    rdfs:comment "A named biological model or verified model family as released. Most are families, which are neither executable implementations nor trained artifacts." .

rb:Configuration a owl:Class ; rdfs:subClassOf rb:System ;
    rdfs:label "configuration" ;
    rdfs:comment "The exact checkpoint, settings or adaptation that produced scores. Often a label reported by a paper or challenge rather than a trained artifact." .

rb:Pipeline a owl:Class ; rdfs:subClassOf mls:Implementation, rb:System ;
    rdfs:label "pipeline" ;
    rdfs:comment "A composed workflow. Its results are not results of any model it uses." .

rb:Service a owl:Class ; rdfs:subClassOf schema:WebAPI, rb:System ;
    rdfs:label "service" ;
    rdfs:comment "A hosted interface with its own terms and limits; not equivalent to the model behind it." .

rb:Benchmark a owl:Class ; rdfs:subClassOf rb:Assessment ;
    rdfs:label "benchmark" ;
    rdfs:comment "A top-level suite or challenge." .

rb:Task a owl:Class ; rdfs:subClassOf rb:Assessment ;
    rdfs:label "task" ;
    rdfs:comment "A biological question or capability, independent of one evaluation implementation." .

rb:Protocol a owl:Class ; rdfs:subClassOf obo:OBI_0000272, rb:Assessment ;
    rdfs:label "protocol" ;
    rdfs:comment "A concrete assessment procedure: data, split, inputs, adaptation and scoring." .

rb:Evaluator a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ;
    rdfs:label "evaluator" ;
    rdfs:comment "Software or a procedure that scores predictions." .

rb:Dataset a owl:Class ; rdfs:subClassOf dcat:Dataset ;
    rdfs:label "dataset" ;
    rdfs:comment "Biological observations, assays or reference collections." .

rb:DatasetSubset a owl:Class ; rdfs:subClassOf rb:Dataset ;
    rdfs:label "dataset subset" ;
    rdfs:comment "An explicitly identified evaluation cohort or subset. A subset is itself a dataset." .

rb:Baseline a owl:Class ;
    rdfs:label "baseline" ;
    rdfs:comment "A task-specific reference or control procedure." .

rb:Evaluation a owl:Class ; rdfs:subClassOf mls:Run ;
    rdfs:label "evaluation" ;
    rdfs:comment "One reported execution of a system under an assessment on data." .

rb:Result a owl:Class ; rdfs:subClassOf mls:ModelEvaluation ;
    rdfs:label "result" ;
    rdfs:comment "One reported measurement of an evaluation, with provenance and review status." .

rb:Source a owl:Class ; rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "source" ;
    rdfs:comment "A versioned paper, supplement, repository file or web page." .

rb:Claim a owl:Class ;
    rdfs:label "claim" ;
    rdfs:comment "One sourced assertion about another record." .

rb:RelevanceJudgement a owl:Class ; rdfs:subClassOf rb:Claim, obo:SEPIO_0000001 ;
    rdfs:label "relevance judgement" ;
    rdfs:comment "A claim grading how directly a protocol's evaluations bear on a use case (direct, proxy or outside scope), with the endpoint, rationale and caveats of that grading. A SEPIO assertion: a statement made by a particular agent on a particular occasion, based on evaluating evidence. Other claims stay rb:Claim only, because not all of them are assertions of this kind; many record a study's findings." .

rb:UseCase a owl:Class ;
    rdfs:label "use case" ;
    rdfs:comment "A research or clinical decision question with its intended users, available inputs, desired output and setting. No external class matches: IAO objective and plan specifications are directives realised by processes, schema:Question is a Comment, and NCIT Use Case is a software interaction script." .

# Links between records (asserted) ------------------------------------------------------------

rb:evaluation a owl:ObjectProperty ;
    rdfs:label "evaluation" ;
    rdfs:comment "Result to its evaluation." .

rb:testedSystem a owl:ObjectProperty ;
    rdfs:label "tested system" ;
    rdfs:comment "Evaluation to the configuration, model, method, pipeline or service it evaluated. Not inherited by families." .

rb:testedOn a owl:ObjectProperty ;
    rdfs:label "tested on" ;
    rdfs:comment "Evaluation to the task, protocol or benchmark it was assessed on." .

rb:dataset a owl:ObjectProperty ;
    rdfs:label "dataset" ;
    rdfs:comment "Evaluation to the dataset or dataset subset it used." .

rb:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by" ;
    rdfs:comment "Baseline to the configuration, model or method that implements it. A baseline is not an evaluation, so this is not rb:testedSystem." .

rb:measuredIn a owl:ObjectProperty ;
    rdfs:label "measured in" ;
    rdfs:comment "Baseline to an evaluation that measured it as a comparator. The values belong to that evaluation's results; a baseline is not a result." .

rb:usesData a owl:ObjectProperty ;
    rdfs:label "uses data" ;
    rdfs:comment "Task, protocol or baseline to the data it uses. Not what an evaluation was run on." .

rb:usedIn a owl:ObjectProperty ;
    rdfs:label "used in" ;
    rdfs:comment "Dataset subset to the protocol that uses it." .

rb:configurationOf a owl:ObjectProperty ;
    rdfs:label "configuration of" ;
    rdfs:comment "Configuration to the model, method or pipeline it configures. Not transitive; results roll up only when a claim backs the link." .

rb:family a owl:ObjectProperty ;
    rdfs:label "family" ;
    rdfs:comment "Configuration or variant to its model family. Results roll up only when a claim backs the link; the build infers nothing from it." .

rb:variantOf a owl:ObjectProperty ;
    rdfs:label "variant of" ;
    rdfs:comment "Model to the model it is a variant of. Not transitive." .

rb:aliasOf a owl:ObjectProperty ;
    rdfs:label "alias of" ;
    rdfs:comment "Same identity under another ID. Deliberately not owl:sameAs, which would merge results without review." .

rb:usesModel a owl:ObjectProperty ;
    rdfs:label "uses model" ;
    rdfs:comment "A pipeline or service depends on a model. Not transitive and not a subproperty of rb:testedSystem: pipeline results are never results of the model." .

rb:evaluatesTask a owl:ObjectProperty ;
    rdfs:label "evaluates task" ;
    rdfs:comment "Resource to the task it evaluates." .

rb:parent a owl:ObjectProperty ; rdfs:subPropertyOf rb:within ;
    rdfs:label "parent" ;
    rdfs:comment "Hierarchy within a benchmark." .

rb:originalEvaluation a owl:ObjectProperty ;
    rdfs:label "original evaluation" ;
    rdfs:comment "A copied result to the evaluation it was copied from." .

rb:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    rdfs:comment "Claim to the record it is about." .

rb:assessedBy a owl:ObjectProperty ;
    rdfs:label "assessed by" ;
    rdfs:comment "Use case to a protocol that a relevance judgement claim grades for it. The link is exported whatever the judgement's review status; whether its evaluations are shown as evidence depends on that claim's status and grade. Asserted only, never inferred, and in no property chain, so no result becomes a result of a use case." .

rb:applicableTo a owl:ObjectProperty ;
    rdfs:label "applicable to" ;
    rdfs:comment "Candidate applicability; not evidence of performance." .

rb:sameDataAs a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "same data as" ;
    rdfs:comment "Informational data reuse, in either direction; never merges results." .

rb:companionOf a owl:ObjectProperty ;
    rdfs:label "companion of" ;
    rdfs:comment "A source that belongs with a paper (its repository, leaderboard, supplement or another version of the paper) to the paper's source. Used only to group sources into studies; never merges results." .

rb:link a owl:ObjectProperty ;
    rdfs:label "link" ;
    rdfs:comment "A link object in the JSON-LD view of a record." .

rb:relation a owl:ObjectProperty ;
    rdfs:label "relation" ;
    rdfs:comment "The relation of a link object in the JSON-LD view of a record." .

rb:target a owl:ObjectProperty ;
    rdfs:label "target" ;
    rdfs:comment "The target record of a link object in the JSON-LD view of a record." .

rb:partOf a owl:ObjectProperty ; rdfs:subPropertyOf dcterms:isPartOf, rb:within ;
    rdfs:label "part of" ;
    rdfs:comment "A task or protocol to the benchmark or suite it is a component of." .

# Inferred links ------------------------------------------------------------

rb:testedIn a owl:ObjectProperty ; owl:inverseOf rb:testedSystem ;
    rdfs:label "tested in" ;
    rdfs:comment "System to the evaluations that tested it directly. Inferred." .

rb:within a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "within" ;
    rdfs:comment "Part of a benchmark or suite, directly or through intermediate parts. Inferred from rb:partOf and rb:parent." .

rb:contains a owl:ObjectProperty ; owl:inverseOf rb:within ;
    rdfs:label "contains" ;
    rdfs:comment "Benchmark or suite to every task and protocol inside it. Inferred." .

rb:hasResult a owl:ObjectProperty ; owl:inverseOf rb:evaluation ;
    rdfs:label "has result" ;
    rdfs:comment "Evaluation to its results. Inferred." .

rb:resultFor a owl:ObjectProperty ;
    owl:propertyChainAxiom ( rb:evaluation rb:testedSystem ) ;
    rdfs:label "result for" ;
    rdfs:comment "Result to the system its evaluation tested. Never extends to model families or models a pipeline uses. Inferred." .

rb:resultOn a owl:ObjectProperty ;
    owl:propertyChainAxiom ( rb:evaluation rb:testedOn ) ;
    rdfs:label "result on" ;
    rdfs:comment "Result to the task or protocol its evaluation used. Inferred." .

rb:resultOnDataset a owl:ObjectProperty ;
    owl:propertyChainAxiom ( rb:evaluation rb:dataset ) ;
    rdfs:label "result on dataset" ;
    rdfs:comment "Result to the dataset or subset its evaluation used. Inferred." .

rb:testedWithin a owl:ObjectProperty ;
    owl:propertyChainAxiom ( rb:testedOn rb:within ) ;
    rdfs:label "tested within" ;
    rdfs:comment "Evaluation to each benchmark or suite containing the task or protocol it used. Inferred." .

rb:resultWithin a owl:ObjectProperty ;
    owl:propertyChainAxiom ( rb:evaluation rb:testedWithin ) ;
    rdfs:label "result within" ;
    rdfs:comment "Result to each benchmark or suite containing the task or protocol of its evaluation. Inferred." .

# Values ------------------------------------------------------------------------------------
# Controlled fields hold concepts from the SKOS schemes in data/vocab/; free-text fields are literals.

rb:status a owl:ObjectProperty ; rdfs:label "status" ; rdfs:comment "Review status of the record (vocab/status)." .
rb:area a owl:ObjectProperty ; rdfs:label "area" ; rdfs:comment "Research area (vocab/area)." .
rb:methodType a owl:ObjectProperty ; rdfs:label "method type" ; rdfs:comment "Broad kind of method or model (vocab/method-type)." .
rb:context a owl:ObjectProperty ; rdfs:label "context" ; rdfs:comment "Use context (vocab/context)." .
rb:entityLevel a owl:ObjectProperty ; rdfs:label "entity level" ; rdfs:comment "The level of identity a record describes (vocab/entity-level)." .
rb:publicationStatus a owl:ObjectProperty ; rdfs:label "publication status" ; rdfs:comment "Publication status of a source (vocab/publication-status)." .
rb:origin a owl:ObjectProperty ; rdfs:label "origin" ; rdfs:comment "Who reported an evaluation (vocab/origin)." .
rb:baselineType a owl:ObjectProperty ; rdfs:label "baseline type" ; rdfs:comment "Kind of baseline or comparator (vocab/baseline-type)." .
rb:baselineAlgorithm a owl:ObjectProperty ; rdfs:label "baseline algorithm" ; rdfs:comment "The learning algorithm of a simple statistical baseline (vocab/algorithm)." .
rb:configurationType a owl:ObjectProperty ; rdfs:label "configuration type" ; rdfs:comment "How a configuration record was established (vocab/configuration-type)." .
rb:metric a owl:ObjectProperty ; rdfs:subPropertyOf mls:specifiedBy ; rdfs:label "metric" ;
    rdfs:comment "The evaluation measure a result reports (vocab/metric, each an mls:EvaluationMeasure)." .
rb:metricQualifier a owl:DatatypeProperty ; rdfs:label "metric qualifier" ;
    rdfs:comment "What distinguishes results that share a metric concept: a class, setting, scope, cutoff or aggregation." .
rb:unit a owl:ObjectProperty ; rdfs:label "unit" ; rdfs:comment "Unit of a result value (vocab/unit, matched to QUDT)." .
rb:metricDirection a owl:ObjectProperty ; rdfs:label "metric direction" ; rdfs:comment "Whether higher or lower values are better for this result (vocab/direction)." .
rb:defaultDirection a owl:ObjectProperty ; rdfs:label "default direction" ; rdfs:comment "A metric concept's usual direction (vocab/direction)." .
rb:reviewMethod a owl:ObjectProperty ; rdfs:label "review method" ; rdfs:comment "How a record's values were checked (vocab/review-method)." .
rb:reviewedBy a owl:ObjectProperty ; rdfs:label "reviewed by" ; rdfs:comment "The agent that reviewed or extracted a record (vocab/agent)." .
rb:unitDetail a owl:DatatypeProperty ; rdfs:label "unit detail" ; rdfs:comment "What the unit concept cannot hold: the counted entity, a printed scale or an unreported base unit." .
rb:reviewMethodNote a owl:DatatypeProperty ; rdfs:label "review method note" ; rdfs:comment "Details of the review beyond its method concept." .
rb:reviewerNote a owl:DatatypeProperty ; rdfs:label "reviewer note" ; rdfs:comment "The reviewer's role, and statements such as no human review." .
rb:taskFacet a owl:DatatypeProperty ; rdfs:label "task facet" ; rdfs:comment "Free-text task label used for browsing." .
rb:doi a owl:DatatypeProperty ; rdfs:label "DOI" ; rdfs:comment "Digital Object Identifier of a source." .
rb:retrievedAt a owl:DatatypeProperty ; rdfs:label "retrieved at" ; rdfs:comment "When a source was retrieved (xsd:date or xsd:dateTime)." .
rb:artifactSha256 a owl:DatatypeProperty ; rdfs:label "artifact SHA-256" ; rdfs:comment "SHA-256 of the retrieved source artifact." .
rb:printedValue a owl:DatatypeProperty ; rdfs:label "printed value" ; rdfs:comment "The value exactly as printed in the source." .
rb:uncertainty a owl:DatatypeProperty ; rdfs:label "uncertainty" ; rdfs:comment "Reported uncertainty of a result." .
rb:sourceLocator a owl:DatatypeProperty ; rdfs:label "source locator" ; rdfs:comment "Where in the source the value or statement appears (table, row, page)." .
rb:claimField a owl:DatatypeProperty ; rdfs:label "claim field" ; rdfs:comment "The field of the subject record a claim supports." .
rb:split a owl:DatatypeProperty ; rdfs:label "split" ; rdfs:comment "Data split a result was measured on." .
rb:reviewDate a owl:DatatypeProperty ; rdfs:label "review date" ; rdfs:comment "The date a record was reviewed (xsd:date)." .
rb:reviewedAt a owl:DatatypeProperty ; rdfs:label "reviewed at" ; rdfs:comment "The time a review completed (xsd:dateTime), recorded separately from the review date by some intakes." .

# Discrepancies (derived graph) ----------------------------------------------------------------
# Written by scripts/kg/contradictions.py after inference, into the derived graph. Each is a
# SEPIO assertion that one source's results disagree with other sources' results for the same
# systems, with the results and sources as its evidence. It is a lead to investigate, not a
# ruling: no result's status or value changes because of it.

rb:Discrepancy a owl:Class ; rdfs:subClassOf obo:SEPIO_0000001 ;
    rdfs:label "discrepancy" ;
    rdfs:comment "An assertion, made by a stated rule, that results from one source disagree with results from other independent sources for the same systems." .

rb:OrderingReversal a owl:Class ; rdfs:subClassOf rb:Discrepancy ;
    rdfs:label "ordering reversal" ;
    rdfs:comment "Other sources consistently rank one system above another; the outlier source consistently ranks them the other way round (vocab/discrepancy-rule/ordering-reversal)." .

rb:GapOutlier a owl:Class ; rdfs:subClassOf rb:Discrepancy ;
    rdfs:label "gap outlier" ;
    rdfs:comment "The outlier source's relative difference between a system and a reference system lies outside the range of the other sources (vocab/discrepancy-rule/gap-outlier)." .

rb:TwoStudyConflict a owl:Class ; rdfs:subClassOf rb:Discrepancy ;
    rdfs:label "two-study conflict" ;
    rdfs:comment "Only two independent sources give a verdict on a pair of systems, and they rank them opposite ways. Neither is the outlier (vocab/discrepancy-rule/two-study-conflict)." .

rb:ResolvedDiscrepancy a owl:Class ; rdfs:subClassOf rb:Discrepancy ;
    rdfs:label "resolved discrepancy" ;
    rdfs:comment "A discrepancy settled by review (explained, confirmed error or false positive) that the rules no longer find, for example because its results were disputed. It keeps its follow-up actions and the systems its review claims are about, but no rule, evidence links or numbers." .

rb:discrepancyRule a owl:ObjectProperty ; rdfs:label "discrepancy rule" ;
    rdfs:comment "The rule that found the discrepancy (vocab/discrepancy-rule)." .
rb:assertionMethod a owl:ObjectProperty ; rdfs:label "assertion method" ;
    rdfs:comment "ECO automatic assertion (ECO_0000203) while only the rule has made it; ECO manual assertion (ECO_0000218) once a reviewer has decided." .
rb:reviewState a owl:ObjectProperty ; rdfs:label "review state" ;
    rdfs:comment "Open, or the reviewer's decision (vocab/discrepancy-state)." .
rb:reviewClaim a owl:ObjectProperty ; rdfs:label "review claim" ;
    rdfs:comment "The discrepancy_review claim that records the reviewer's decision." .
rb:comparedSystem a owl:ObjectProperty ; rdfs:label "compared system" ;
    rdfs:comment "A model or method whose results the discrepancy compares." .
rb:consensusHigher a owl:ObjectProperty ; rdfs:label "consensus higher" ;
    rdfs:comment "For an ordering reversal, the system the other sources rank higher." .
rb:referenceSystem a owl:ObjectProperty ; rdfs:label "reference system" ;
    rdfs:comment "For a gap outlier, the system the gaps are measured against." .
rb:outlierSource a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000438 ;
    rdfs:label "outlier source" ;
    rdfs:comment "The source whose results disagree with the others." .
rb:consensusSource a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000438 ;
    rdfs:label "consensus source" ;
    rdfs:comment "An independent source whose results make up the consensus." .
rb:outlierResult a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000440 ;
    rdfs:label "outlier result" ;
    rdfs:comment "A result from the outlier source that the rule compared." .
rb:consensusResult a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000440 ;
    rdfs:label "consensus result" ;
    rdfs:comment "A result from a consensus source that the rule compared." .
rb:partySource a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000438 ;
    rdfs:label "party source" ;
    rdfs:comment "For a two-study conflict, a source of one of the two studies." .
rb:partyResult a owl:ObjectProperty ; rdfs:subPropertyOf obo:SEPIO_0000440 ;
    rdfs:label "party result" ;
    rdfs:comment "For a two-study conflict, a result from either study that the rule compared." .
rb:unlinkedProtocol a owl:ObjectProperty ; rdfs:label "unlinked protocol" ;
    rdfs:comment "A protocol the discrepancy compares that has no task, benchmark or suite link, so the scope may be unknown." .
rb:discrepancyScope a owl:DatatypeProperty ; rdfs:label "discrepancy scope" ;
    rdfs:comment "same-protocol, same-task, different-task, or unknown when a compared protocol has no task, benchmark or suite link." .
rb:listing a owl:DatatypeProperty ; rdfs:label "listing" ;
    rdfs:comment "public: shown on the contested page by default (same-protocol or same-task, or under active review). review: listed for curation." .
rb:variantMismatch a owl:DatatypeProperty ; rdfs:label "variant mismatch" ;
    rdfs:comment "true when the studies used configurations of a system with different recorded model sizes (xsd:boolean)." .
rb:identityBasis a owl:DatatypeProperty ; rdfs:label "identity basis" ;
    rdfs:comment "reviewed if every configuration-to-model link used is backed by a checked claim, otherwise unreviewed." .
rb:severity a owl:DatatypeProperty ; rdfs:label "severity" ;
    rdfs:comment "high, medium or low: capped by the scope, limited by the number of consensus studies, and lowered for unreviewed identity or a variant mismatch." .
rb:outlierComparisons a owl:DatatypeProperty ; rdfs:label "outlier comparisons" ;
    rdfs:comment "Number of pairwise comparisons from the outlier source (xsd:integer)." .
rb:outlierReversals a owl:DatatypeProperty ; rdfs:label "outlier reversals" ;
    rdfs:comment "Of those, how many reverse the consensus order (xsd:integer)." .
rb:consensusComparisons a owl:DatatypeProperty ; rdfs:label "consensus comparisons" ;
    rdfs:comment "Number of pairwise comparisons from the consensus sources (xsd:integer)." .
rb:consensusAgreements a owl:DatatypeProperty ; rdfs:label "consensus agreements" ;
    rdfs:comment "Of those, how many follow the consensus order (xsd:integer)." .
rb:consensusStudies a owl:DatatypeProperty ; rdfs:label "consensus studies" ;
    rdfs:comment "For an ordering reversal, the number of other studies that give a verdict (xsd:integer)." .
rb:consensusStudyAgreements a owl:DatatypeProperty ; rdfs:label "consensus study agreements" ;
    rdfs:comment "Of those, how many rank the systems in the consensus order (xsd:integer)." .
rb:outlierGap a owl:DatatypeProperty ; rdfs:label "outlier gap" ;
    rdfs:comment "For a gap outlier, the outlier source's median relative difference (xsd:decimal)." .
rb:consensusGapMin a owl:DatatypeProperty ; rdfs:label "consensus gap minimum" ;
    rdfs:comment "For a gap outlier, the smallest median relative difference among the other sources (xsd:decimal)." .
rb:consensusGapMax a owl:DatatypeProperty ; rdfs:label "consensus gap maximum" ;
    rdfs:comment "For a gap outlier, the largest median relative difference among the other sources (xsd:decimal)." .
rb:discrepancySummary a owl:DatatypeProperty ; rdfs:label "discrepancy summary" ;
    rdfs:comment "One plain sentence stating the disagreement." .

# Follow-up actions: one node per accepted discrepancy_review claim revision, so the history of
# what was done stays visible after later revisions. The latest revision also sets rb:reviewState.
rb:FollowUpAction a owl:Class ;
    rdfs:label "follow-up action" ;
    rdfs:comment "One step taken about a discrepancy, recorded by one discrepancy_review claim revision: what was done, when, and the review state it left." .
rb:hasAction a owl:ObjectProperty ; rdfs:label "has action" ;
    rdfs:comment "Discrepancy to a follow-up action recorded for it." .
rb:actionType a owl:ObjectProperty ; rdfs:label "action type" ;
    rdfs:comment "What was done (vocab/discrepancy-action). Absent when the claim records a state change only." .
rb:actionDate a owl:DatatypeProperty ; rdfs:label "action date" ;
    rdfs:comment "When the action was taken (xsd:date). Taken from the claim's date attribute, else its reported_on." .
rb:actionUrl a owl:ObjectProperty ; rdfs:label "action URL" ;
    rdfs:comment "Where the action can be read: the claim's report_url, or else its investigation_url." .
rb:actionRevision a owl:DatatypeProperty ; rdfs:label "action revision" ;
    rdfs:comment "The revision of the claim that recorded the action (xsd:integer); actions are ordered by it." .
rb:resultingState a owl:ObjectProperty ; rdfs:label "resulting state" ;
    rdfs:comment "The review state the action left the discrepancy in (vocab/discrepancy-state)." .
rb:discrepancyKey a owl:DatatypeProperty ; rdfs:label "discrepancy key" ;
    rdfs:comment "The canonical key the discrepancy's ID hashes: rule, compared systems, anchor, metric and outlier study key." .
