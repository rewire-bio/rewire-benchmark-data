# SHACL shapes for the derived graph (derived.nq): the discrepancies scripts/kg/contradictions.py
# writes after inference, and their follow-up actions. scripts/kg/build.py validates the derived
# statements against these, with the vocabulary and concept schemes mixed in; a violation fails
# the build. check_derived in contradictions.py runs first as a fast check that no statement is
# about a record. Changes are reviewed like record changes.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix rbs: <https://benchmarks.rewire.it/shapes#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

rbs:DiscrepancyRuleConcept a sh:NodeShape ;
    sh:class skos:Concept ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/discrepancy-rule/> ; sh:minCount 1 ] .

rbs:DiscrepancyStateConcept a sh:NodeShape ;
    sh:class skos:Concept ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/discrepancy-state/> ; sh:minCount 1 ] .

rbs:DiscrepancyActionConcept a sh:NodeShape ;
    sh:class skos:Concept ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue <https://benchmarks.rewire.it/vocab/discrepancy-action/> ; sh:minCount 1 ] .

rbs:Discrepancy a sh:NodeShape ;
    sh:targetClass rb:Discrepancy ;
    rdfs:comment "Every discrepancy has a label, summary, severity, review state and assertion method. A live one (found by a rule on this release) or a resolved one (settled, and no longer found): exactly one of the rule-specific shapes or the resolved shape applies." ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://benchmarks\\.rewire\\.it/id/discrepancy-[0-9a-f]{16}$" ;
    sh:xone ( rbs:OrderingReversalNumbers rbs:GapOutlierNumbers rbs:TwoStudyConflictNumbers rbs:ResolvedDiscrepancy ) ;
    sh:property
        [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path rb:discrepancySummary ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path rb:reviewState ; sh:minCount 1 ; sh:maxCount 1 ; sh:node rbs:DiscrepancyStateConcept ] ,
        [ sh:path rb:assertionMethod ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( <http://purl.obolibrary.org/obo/ECO_0000203> <http://purl.obolibrary.org/obo/ECO_0000218> ) ] ,
        [ sh:path rb:comparedSystem ; sh:maxCount 2 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:severity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "low" "medium" "high" ) ] ,
        [ sh:path rb:reviewClaim ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:previousIds ; sh:datatype xsd:string ; sh:pattern "^discrepancy-[0-9a-f]{16}$" ] ,
        [ sh:path rb:hasAction ; sh:class rb:FollowUpAction ] .

rbs:LiveDiscrepancy a sh:NodeShape ;
    rdfs:comment "A discrepancy a rule found on this release: its rule, the key its ID hashes, two compared systems, its scope, listing and identity basis. The rule-specific shapes require the outlier and consensus sources and results, or a two-study conflict's party sources and results." ;
    sh:property
        [ sh:path rb:discrepancyKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path rb:discrepancyRule ; sh:minCount 1 ; sh:maxCount 1 ; sh:node rbs:DiscrepancyRuleConcept ] ,
        [ sh:path rb:comparedSystem ; sh:minCount 2 ] ,
        [ sh:path rb:discrepancyScope ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( "same-protocol" "same-task" "different-task" "unknown" ) ] ,
        [ sh:path rb:identityBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "reviewed" "unreviewed" ) ] ,
        [ sh:path rb:listing ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "public" "review" ) ] ,
        [ sh:path rb:variantMismatch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
        [ sh:path rb:unlinkedProtocol ; sh:nodeKind sh:IRI ] .

rbs:OutlierEvidence a sh:NodeShape ;
    rdfs:comment "An outlier finding's evidence: the outlier and consensus sources and results, and no party links." ;
    sh:property
        [ sh:path rb:outlierSource ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:consensusSource ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:outlierResult ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:consensusResult ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:partySource ; sh:maxCount 0 ] ,
        [ sh:path rb:partyResult ; sh:maxCount 0 ] .

rbs:ResolvedDiscrepancy a sh:NodeShape ;
    sh:class rb:ResolvedDiscrepancy ;
    rdfs:comment "A settled discrepancy the rules no longer find: a terminal review state, the review claim and its actions, and none of a live discrepancy's rule, key, evidence links or numbers." ;
    sh:property
        [ sh:path rb:reviewState ; sh:in ( <https://benchmarks.rewire.it/vocab/discrepancy-state/explained>
              <https://benchmarks.rewire.it/vocab/discrepancy-state/confirmed-error>
              <https://benchmarks.rewire.it/vocab/discrepancy-state/false-positive> ) ] ,
        [ sh:path rb:assertionMethod ; sh:hasValue <http://purl.obolibrary.org/obo/ECO_0000218> ] ,
        [ sh:path rb:reviewClaim ; sh:minCount 1 ] ,
        [ sh:path rb:hasAction ; sh:minCount 1 ] ,
        [ sh:path rb:discrepancyKey ; sh:maxCount 0 ] ,
        [ sh:path rb:discrepancyRule ; sh:maxCount 0 ] ,
        [ sh:path rb:discrepancyScope ; sh:maxCount 0 ] ,
        [ sh:path rb:identityBasis ; sh:maxCount 0 ] ,
        [ sh:path rb:outlierSource ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusSource ; sh:maxCount 0 ] ,
        [ sh:path rb:outlierResult ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusResult ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusHigher ; sh:maxCount 0 ] ,
        [ sh:path rb:referenceSystem ; sh:maxCount 0 ] ,
        [ sh:path rb:outlierComparisons ; sh:maxCount 0 ] ,
        [ sh:path rb:outlierGap ; sh:maxCount 0 ] ,
        [ sh:path rb:partySource ; sh:maxCount 0 ] ,
        [ sh:path rb:partyResult ; sh:maxCount 0 ] ,
        [ sh:path rb:listing ; sh:maxCount 0 ] ,
        [ sh:path rb:unlinkedProtocol ; sh:maxCount 0 ] .

rbs:OrderingReversalNumbers a sh:NodeShape ;
    sh:class rb:OrderingReversal ;
    sh:node rbs:LiveDiscrepancy, rbs:OutlierEvidence ;
    sh:property
        [ sh:path rb:consensusHigher ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:consensusStudies ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:consensusStudyAgreements ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:outlierComparisons ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:outlierReversals ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:consensusComparisons ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:consensusAgreements ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:referenceSystem ; sh:maxCount 0 ] .

rbs:GapOutlierNumbers a sh:NodeShape ;
    sh:class rb:GapOutlier ;
    sh:node rbs:LiveDiscrepancy, rbs:OutlierEvidence ;
    sh:property
        [ sh:path rb:referenceSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:outlierGap ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ,
        [ sh:path rb:consensusGapMin ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ,
        [ sh:path rb:consensusGapMax ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ,
        [ sh:path rb:consensusHigher ; sh:maxCount 0 ] .

rbs:TwoStudyConflictNumbers a sh:NodeShape ;
    sh:class rb:TwoStudyConflict ;
    sh:node rbs:LiveDiscrepancy ;
    rdfs:comment "A two-study conflict names the sources and results of both studies as parties, and no outlier, consensus or reference." ;
    sh:property
        [ sh:path rb:partySource ; sh:minCount 2 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:partyResult ; sh:minCount 2 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:outlierSource ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusSource ; sh:maxCount 0 ] ,
        [ sh:path rb:outlierResult ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusResult ; sh:maxCount 0 ] ,
        [ sh:path rb:consensusHigher ; sh:maxCount 0 ] ,
        [ sh:path rb:referenceSystem ; sh:maxCount 0 ] .

rbs:FollowUpAction a sh:NodeShape ;
    sh:targetClass rb:FollowUpAction ;
    rdfs:comment "One accepted discrepancy_review claim revision, under the discrepancy it is about. The action type is absent for a claim that records a state change only." ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://benchmarks\\.rewire\\.it/id/discrepancy-[0-9a-f]{16}/action/-?[0-9]+$" ;
    sh:property
        [ sh:path [ sh:inversePath rb:hasAction ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rb:Discrepancy ] ,
        [ sh:path rb:actionRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path rb:reviewClaim ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:resultingState ; sh:minCount 1 ; sh:maxCount 1 ; sh:node rbs:DiscrepancyStateConcept ] ,
        [ sh:path rb:actionType ; sh:maxCount 1 ; sh:node rbs:DiscrepancyActionConcept ] ,
        [ sh:path rb:actionDate ; sh:maxCount 1 ; sh:datatype xsd:date ] ,
        [ sh:path rb:actionUrl ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path rb:nextCheck ; sh:maxCount 1 ; sh:datatype xsd:date ] .

rbs:DerivedSubjects a sh:NodeShape ;
    sh:targetSubjectsOf rb:hasAction, rb:discrepancyRule, rb:outlierResult, rb:consensusResult, rb:partyResult ;
    rdfs:comment "Only discrepancies carry discrepancy links." ;
    sh:class rb:Discrepancy .

rbs:ActionSubjects a sh:NodeShape ;
    sh:targetSubjectsOf rb:actionRevision, rb:resultingState, rb:actionType, rb:actionUrl ;
    rdfs:comment "Only follow-up actions carry action properties." ;
    sh:class rb:FollowUpAction .
