{
  "@context": {
    "@version": 1.1,
    "@base": "https://benchmarks.rewire.it/id/",
    "@vocab": "https://benchmarks.rewire.it/vocab#",
    "rb": "https://benchmarks.rewire.it/vocab#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "mls": "http://www.w3.org/ns/mls#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "obo": "http://purl.obolibrary.org/obo/",
    "id": "@id",
    "kind": {
      "@id": "rdf:type",
      "@type": "@vocab",
      "@context": {
        "method": "rb:Method",
        "model": "rb:Model",
        "configuration": "rb:Configuration",
        "pipeline": "rb:Pipeline",
        "service": "rb:Service",
        "benchmark": "rb:Benchmark",
        "task": "rb:Task",
        "protocol": "rb:Protocol",
        "evaluator": "rb:Evaluator",
        "dataset": "rb:Dataset",
        "dataset_subset": "rb:DatasetSubset",
        "baseline": "rb:Baseline",
        "evaluation": "rb:Evaluation",
        "result": "rb:Result",
        "source": "rb:Source",
        "claim": "rb:Claim"
      }
    },
    "name": {
      "@id": "rdfs:label"
    },
    "description": {
      "@id": "dcterms:description"
    },
    "status": {
      "@id": "rb:status"
    },
    "source_ids": {
      "@id": "dcterms:source",
      "@type": "@id"
    },
    "facets": "@nest",
    "areas": {
      "@id": "rb:area",
      "@nest": "facets"
    },
    "tasks": {
      "@id": "rb:taskFacet",
      "@nest": "facets"
    },
    "contexts": {
      "@id": "rb:context",
      "@nest": "facets"
    },
    "method_types": {
      "@id": "rb:methodType",
      "@nest": "facets"
    },
    "domain": {
      "@id": "rb:domain",
      "@nest": "facets"
    },
    "attributes": "@nest",
    "version": {
      "@id": "schema:version",
      "@nest": "attributes"
    },
    "entity_level": {
      "@id": "rb:entityLevel",
      "@nest": "attributes"
    },
    "url": {
      "@id": "schema:url",
      "@type": "@id",
      "@nest": "attributes"
    },
    "doi": {
      "@id": "rb:doi",
      "@nest": "attributes"
    },
    "retrieved_at": {
      "@id": "rb:retrievedAt",
      "@type": "xsd:dateTime",
      "@nest": "attributes"
    },
    "artifact_sha256": {
      "@id": "rb:artifactSha256",
      "@nest": "attributes"
    },
    "publication_status": {
      "@id": "rb:publicationStatus",
      "@nest": "attributes"
    },
    "origin": {
      "@id": "rb:origin",
      "@nest": "attributes"
    },
    "metric": {
      "@id": "rb:metric",
      "@nest": "attributes"
    },
    "metric_direction": {
      "@id": "rb:metricDirection",
      "@nest": "attributes"
    },
    "unit": {
      "@id": "rb:unit",
      "@nest": "attributes"
    },
    "printed_value": {
      "@id": "rb:printedValue",
      "@nest": "attributes"
    },
    "numeric_value": {
      "@id": "mls:hasValue",
      "@type": "xsd:decimal",
      "@nest": "attributes"
    },
    "uncertainty": {
      "@id": "rb:uncertainty",
      "@nest": "attributes"
    },
    "source_locator": {
      "@id": "rb:sourceLocator",
      "@nest": "attributes"
    },
    "field": {
      "@id": "rb:claimField",
      "@nest": "attributes"
    },
    "split": {
      "@id": "rb:split",
      "@nest": "attributes"
    },
    "links": {
      "@id": "rb:link"
    },
    "relation": {
      "@id": "rb:relation",
      "@type": "@vocab",
      "@context": {
        "evaluation": "rb:evaluation",
        "model": "rb:evaluatedSubject",
        "configuration": "rb:configuration",
        "method": "rb:method",
        "pipeline": "rb:pipeline",
        "service": "rb:service",
        "benchmark": "rb:evaluatedOn",
        "protocol": "rb:protocol",
        "task": "rb:task",
        "evaluator": "rb:evaluator",
        "dataset": "rb:dataset",
        "dataset_subset": "rb:datasetSubset",
        "baseline": "rb:baseline",
        "family": "rb:family",
        "variant_of": "rb:variantOf",
        "alias_of": "rb:aliasOf",
        "uses_model": "rb:usesModel",
        "part_of": "rb:partOf",
        "evaluates_task": "rb:evaluatesTask",
        "parent": "rb:parent",
        "supersedes": "dcterms:replaces",
        "original_evaluation": "rb:originalEvaluation",
        "subject": "rb:subject",
        "source": "dcterms:source",
        "applicable_to": "rb:applicableTo",
        "same_data_as": "rb:sameDataAs"
      }
    },
    "target_id": {
      "@id": "rb:target",
      "@type": "@id"
    }
  }
}
