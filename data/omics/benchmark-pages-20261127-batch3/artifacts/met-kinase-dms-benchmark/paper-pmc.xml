orcid" authenticated="false">http://orcid.org/0000-0002-5080-2859</contrib-id></contrib></contrib-group><pub-date pub-type="epub"><day>12</day><month>11</month><year>2026</year></pub-date><issue-id pub-id-type="pmc-issue-id">525573</issue-id><elocation-id>2026.11.01.763444</elocation-id><pub-history><event event-type="pmc-release"><date><day>18</day><month>11</month><year>2026</year></date></event><event event-type="pmc-live"><date><day>19</day><month>11</month><year>2026</year></date></event><event event-type="pmc-last-change"><date iso-8601-date="2026-11-20 13:57:35.253"><day>20</day><month>11</month><year>2026</year></date></event></pub-history><permissions><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbylicense">https://creativecommons.org/licenses/by/4.0/</ali:license_ref><license-p>This work is licensed under a <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International License</ext-link>, which allows reusers to distribute, remix, adapt, and build upon the material in any medium or format, so long as attribution is given to the creator. The license allows for commercial use.</license-p></license></permissions><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" content-type="pmc-pdf" xlink:href="nihpp-2026.11.01.763444v2.pdf"/><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://biorxiv.org/lookup/doi/10.64898/2026.11.01.763444">http://biorxiv.org/lookup/doi/10.64898/2026.11.01.763444</self-uri><self-uri content-type="pdf">nihpp-2026.11.01.763444.pdf</self-uri><abstract><title>Abstract</title><p>Recent advances in protein language models, geometric deep learning, and structure prediction frameworks have the potential to accelerate computational drug discovery. However, it remains unclear how well these methods generalize beyond their training sets. Mutation-dependent drug responses present a challenge to these methods because there are often large effects from relatively small perturbations. Here, we systematically benchmark diverse mutational effect and drug-target affinity prediction models using deep mutational scanning datasets spanning 11 inhibitor conditions for the MET kinase domain. Across both mutational effect prediction and drug–target affinity tasks, current AI models produce largely ligand-invariant predictions despite experimentally distinct inhibitor-dependent fitness landscapes. Ligand-aware geometric models, including LigandMPNN and LASErMPNN, partially recover experimentally validated resistance-associated hotspots, highlighting the importance of explicitly modeling protein–ligand interactions and local structural flexibility. In contrast, deep learning affinity prediction models underestimate mutation-induced changes in binding affinity. This deficiency likely reflects mutation-invariant structural priors derived from co-folded structure prediction frameworks and the absence of mutation-conditioned supervision in current affinity datasets. Finally, we further extended our analysis to several kinase-inhibitor deep mutational scanning datasets and confirm the overall trends. Our findings suggest that a primary limitation in improving performance on this task lies in the scarcity of mutation-conditioned protein-ligand training data rather than model architecture alone.</p></abstract><custom-meta-group><custom-meta><meta-name>pmc-status-qastatus</meta-name><meta-value>0</meta-value></custom-meta><custom-meta><meta-name>pmc-status-live</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>pmc-status-embargo</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>pmc-status-released</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>pmc-prop-open-access</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>pmc-pr