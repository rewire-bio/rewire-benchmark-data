{
  "schema": "lncrfm-weights-v1",
  "model_name": "LncRFM",
  "global_step": 300000,
  "precision": "float32",
  "factory_kwargs": {
    "dim": 768,
    "layer": 12,
    "max_length": 2050,
    "use_motif_stem": true,
    "motif_kernel_sizes": [
      3,
      7
    ],
    "motif_dropout": 0.0,
    "residual_in_fp32": true,
    "use_motif_gate": true,
    "motif_gate_init": 0.0,
    "position_embedding_type": "none",
    "use_bidirectional_mixer": true,
    "pair_aware_fusion": true,
    "bidirectional_strategy": "mean",
    "bidirectional_weight_tie": false,
    "attn_layer_idx": [
      5,
      11
    ],
    "attn_cfg": {
      "num_heads": 12,
      "dropout": 0.0,
      "use_masked_attention": true
    },
    "ssm_cfg": {
      "d_state": 64,
      "d_conv": 7,
      "expand": 2,
      "headdim": 64,
      "ngroups": 1,
      "learnable_init_states": false,
      "bias": false,
      "conv_bias": true,
      "chunk_size": 256,
      "use_mem_eff_path": false
    }
  }
}
