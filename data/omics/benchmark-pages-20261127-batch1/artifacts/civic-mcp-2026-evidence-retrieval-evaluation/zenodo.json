{"created": "2026-06-26T18:43:16.027017+00:00", "modified": "2026-06-26T18:43:16.230570+00:00", "id": 20938836, "conceptrecid": "17344049", "doi": "10.5281/zenodo.20938836", "conceptdoi": "10.5281/zenodo.17344049", "doi_url": "https://doi.org/10.5281/zenodo.20938836", "metadata": {"title": "CIViC MCP: Integrating Large Language Models with the Clinical Interpretations of Variants in Cancer", "doi": "10.5281/zenodo.20938836", "publication_date": "2026-06-26", "description": "<p><strong><span>Summary: </span></strong><span>The Clinical Interpretation of Variants in Cancer (CIViC) knowledgebase provides a community-driven, open-source platform for discussing the biological and Clinical Significance of molecular variants in cancer. To enable users to make complex connections between CIViC information, we developed the CIViC Model Context Protocol (MCP) server, which allows large language models (LLMs) to directly interface with the CIViC API through natural language, facilitating the rapid summarization of expertly curated cancer variant interpretations.</span></p>\n<p>This repository includes the open-source <strong>CIViC MCP server</strong> and the <strong>evaluation data</strong> used for benchmarking its performance (including the <code>eval_QA_experiment</code> dataset). Together, these resources support reproducible experimentation with LLMs for biomedical information retrieval and evidence summarization.</p>\n<p><strong>Contents:</strong></p>\n<ul>\n<li>\n<p>MCP server implementation (<code>/civic-mcp-server</code>)</p>\n</li>\n<li>\n<p>Evaluation scripts and results (<code>/eval_QA_experiment</code>)</p>\n</li>\n<li>\n<p>Example GraphQL queries and response templates</p>\n</li>\n<li>\n<p>Documentation for server setup and usage</p>\n</li>\n</ul>", "access_right": "open", "creators": [{"name": "Schimmelpfennig, Lars", "affiliation": "Washington University in St. Louis School of Medicine", "orcid": "0009-0009-0585-2062"}], "custom": {"code:codeRepository": "https://github.com/griffithlab/civic-mcp-server"}, "resource_type": {"title": "Publication", "type": "publication"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "17344049"}}]}}, "title": "CIViC MCP: Integrating Large Language Models with the Clinical Interpretations of Variants in Cancer", "links": {"self": "https://zenodo.org/api/records/20938836", "self_html": "https://zenodo.org/records/20938836", "preview_html": "https://zenodo.org/records/20938836?preview=1", "doi": "https://doi.org/10.5281/zenodo.20938836", "self_doi": "https://doi.org/10.5281/zenodo.20938836", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20938836", "reserve_doi": "https://zenodo.org/api/records/20938836/draft/pids/doi", "parent": "https://zenodo.org/api/records/17344049", "parent_html": "https://zenodo.org/records/17344049", "parent_doi": "https://doi.org/10.5281/zenodo.17344049", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17344049", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:20938836/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:20938836/sequence/default", "files": "https://zenodo.org/api/records/20938836/files", "media_files": "https://zenodo.org/api/records/20938836/media-files", "latest": "https://zenodo.org/api/records/20938836/versions/latest", "latest_html": "https://zenodo.org/records/20938836/latest", "versions": "https://zenodo.org/api/records/20938836/versions", "draft": "https://zenodo.org/api/records/20938836/draft", "access_links": "https://zenodo.org/api/records/20938836/access/links", "access_grants": "https://zenodo.org/api/records/20938836/access/grants", "access_users": "https://zenodo.org/api/records/20938836/access/users", "access_request": "https://zenodo.org/api/records/20938836/access/request", "access": "https://zenodo.org/api/records/20938836/access", "communities": "https://zenodo.org/api/records/20938836/communities", "c