@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://benchmarks.rewire.it/vocab/relevance/> .

<https://benchmarks.rewire.it/vocab/relevance/> a skos:ConceptScheme ;
    skos:prefLabel "Use-case relevance"@en ;
    skos:definition "How directly a protocol's evaluations bear on the decision a use case describes. A grade of closeness to the question, not of support for a proposition, so SEPIO evidence direction and strength do not match."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/issues/42> .

:direct a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/relevance/> ;
    skos:prefLabel "Direct"@en ;
    skos:altLabel "direct"@en ;
    skos:definition "The protocol measures the use case's endpoint on inputs of the kind the use case describes."@en .

:proxy a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/relevance/> ;
    skos:prefLabel "Proxy"@en ;
    skos:altLabel "proxy"@en ;
    skos:definition "The protocol measures a related endpoint, input or setting that informs the use case without measuring its endpoint directly."@en .

:outside_scope a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/relevance/> ;
    skos:prefLabel "Outside scope"@en ;
    skos:altLabel "outside_scope"@en ;
    skos:definition "The protocol was considered and judged not to bear on the use case. It supplies no evidence."@en .
