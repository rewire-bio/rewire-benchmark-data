@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://benchmarks.rewire.it/vocab/discrepancy-action/> .

<https://benchmarks.rewire.it/vocab/discrepancy-action/> a skos:ConceptScheme ;
    skos:prefLabel "Discrepancy follow-up actions"@en ;
    skos:definition "What was done about a discrepancy found by the knowledge-graph build. Each discrepancy_review claim revision records one action and the review state it left the discrepancy in. A claim without an action records a state change only."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/docs/discrepancies.md> .

:investigated a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Investigated"@en ;
    skos:definition "Looked into the disagreeing results: retrieved and read the code, data or supplements behind them."@en .

:contacted-authors a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Contacted authors"@en ;
    skos:definition "Asked the authors of a source a question about the results, without filing a problem report."@en .

:reported-upstream a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Reported upstream"@en ;
    skos:definition "Raised a problem with the authors or maintainers of a source, for example as an issue on their repository."@en .

:awaiting-correction a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Awaiting correction"@en ;
    skos:definition "Recorded the authors' response and what they said they would publish, and when."@en .

:reran a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Reran"@en ;
    skos:definition "Ran the evaluation again, from the authors' code or our own, to check the disagreeing results."@en .

:corrected-records a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Corrected records"@en ;
    skos:definition "Changed the affected records through a reviewed record change: marked results disputed, added an evidence concern or added superseding results."@en .

:closed a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-action/> ;
    skos:prefLabel "Closed"@en ;
    skos:definition "Settled the discrepancy as explained, a confirmed error or a false positive, with the reason."@en .
