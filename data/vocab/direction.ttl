@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/direction/> .

<https://benchmarks.rewire.it/vocab/direction/> a skos:ConceptScheme ;
    skos:prefLabel "Metric directions"@en ;
    skos:definition "Whether higher or lower values of a metric are better."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/direction.csv> .

:higher a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/direction/> ;
    skos:prefLabel "Higher is better"@en ;
    skos:altLabel "higher"@en ;
    skos:definition "Larger values indicate better performance."@en .

:lower a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/direction/> ;
    skos:prefLabel "Lower is better"@en ;
    skos:altLabel "lower"@en ;
    skos:definition "Smaller values indicate better performance."@en .

:unknown a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/direction/> ;
    skos:prefLabel "Direction unknown"@en ;
    skos:definition "Direction not established. A missingness state."@en .
