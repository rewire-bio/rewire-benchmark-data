@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/entity-level/> .

<https://benchmarks.rewire.it/vocab/entity-level/> a skos:ConceptScheme ;
    skos:prefLabel "Entity levels"@en ;
    skos:definition "The level of identity a record describes."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/entity-level.csv> .

:challenge a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Challenge"@en ;
    skos:definition "A community challenge such as CASP or CAPRI (benchmark records)."@en .

:checkpoint a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Checkpoint"@en ;
    skos:definition "A specific released set of weights (model records). In the contract but unused."@en .

:evaluation_subset a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Evaluation subset"@en ;
    skos:altLabel "evaluation_subset"@en ;
    skos:definition "Subset of a dataset used in one evaluation. Not in the contract."@en .

:evaluator a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Evaluator"@en ;
    skos:definition "A scoring or evaluation tool (benchmark records)."@en .

:family a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Model family"@en ;
    skos:definition "A named model or tool family without a fixed checkpoint (model records)."@en .

:method a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Method"@en ;
    skos:definition "A reported method without an identified release (model records)."@en .

:protocol a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Protocol"@en ;
    skos:definition "A specific evaluation protocol (benchmark records)."@en .

:service a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Hosted service"@en ;
    skos:definition "A hosted service or API (model records)."@en .

:suite a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Benchmark suite"@en ;
    skos:definition "A collection of benchmark tasks (benchmark records)."@en .

:task a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/entity-level/> ;
    skos:prefLabel "Task"@en ;
    skos:definition "A benchmark task (benchmark records)."@en .
