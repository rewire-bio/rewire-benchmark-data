@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://benchmarks.rewire.it/vocab/licence-basis/> .

<https://benchmarks.rewire.it/vocab/licence-basis/> a skos:ConceptScheme ;
    skos:prefLabel "Licence determination bases"@en ;
    skos:definition "How a recorded licence string was read into a licence family. It says what the reader had to do, which is what decides whether the determination still needs work."@en ;
    skos:scopeNote "A row with basis unresolved puts every source carrying that string in the licence triage queue."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/archive/licence-map.tsv> .

:identifier a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-basis/> ;
    skos:prefLabel "Licence identifier"@en ;
    skos:altLabel "identifier"@en ;
    skos:definition "The string is a licence identifier and nothing else, for example CC-BY-4.0 or MIT."@en .

:prose a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-basis/> ;
    skos:prefLabel "Prose stating a licence"@en ;
    skos:altLabel "prose"@en ;
    skos:definition "The string is prose, a URL or a quotation that names one licence without ambiguity."@en .

:conflicting a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-basis/> ;
    skos:prefLabel "Conflicting statements"@en ;
    skos:altLabel "conflicting"@en ;
    skos:definition "The source states two licences that disagree. The row takes the more restrictive reading and the note records both statements."@en .

:unresolved a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-basis/> ;
    skos:prefLabel "Unresolved"@en ;
    skos:altLabel "unresolved"@en ;
    skos:definition "The string records that no licence was found, or names terms too vague to give a family. The tier is private and the source goes to the triage queue."@en .
