@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/unit/> .

<https://benchmarks.rewire.it/vocab/unit/> a skos:ConceptScheme ;
    skos:prefLabel "Units"@en ;
    skos:definition "The unit of a result value, matched to QUDT units. Quantities such as scores and correlations are unitless; the metric names the quantity."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/unit.csv> .

:angstrom a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Angstrom"@en ;
    skos:altLabel "angstrom"@en ;
    skos:altLabel "Å"@en ;
    skos:definition "Length of 1e-10 metre; used for structural RMSD."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/ANGSTROM> .

:count a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Count"@en ;
    skos:altLabel "number"@en ;
    skos:altLabel "number of items"@en ;
    skos:definition "Dimensionless count of discrete items. The counted entity (targets, variants, fusions, events) is kept as detail or in the metric."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/NUM> ;
    skos:scopeNote "Not for distances or averages: MCES edit distance is bond-order weighted and averaged over spectra, so it is unitless."@en .

:degree a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Degree"@en ;
    skos:altLabel "degree of arc"@en ;
    skos:altLabel "°"@en ;
    skos:definition "Plane angle, pi/180 radian."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/DEG> .

:electronvolt a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Electronvolt"@en ;
    skos:altLabel "eV"@en ;
    skos:definition "Energy unit, 1.602176634e-19 joule."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/EV> .

:fraction a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Fraction"@en ;
    skos:altLabel "proportion"@en ;
    skos:altLabel "ratio expressed on a 0 to 1 scale"@en ;
    skos:definition "Dimensionless ratio expressed as the value of the ratio itself, normally on a 0 to 1 scale."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/FRACTION> ;
    skos:scopeNote "Only for proportions of items (correct predictions, targets, complexes). Normalised scores such as TM-score, NDCG and AUROC are unitless."@en .

:hour a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Hour"@en ;
    skos:altLabel "h"@en ;
    skos:altLabel "hours"@en ;
    skos:definition "Time, 3600 seconds."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/HR> .

:kilocalorie-per-mole a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Kilocalorie per mole"@en ;
    skos:altLabel "kcal/mol"@en ;
    skos:definition "Molar energy, 4184 joule per mole."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/KiloCAL-PER-MOL> .

:nanometre a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Nanometre"@en ;
    skos:altLabel "nanometer"@en ;
    skos:altLabel "nm"@en ;
    skos:definition "Length of 1e-9 metre."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/NanoM> .

:percent a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Percent"@en ;
    skos:altLabel "%"@en ;
    skos:altLabel "percentage"@en ;
    skos:definition "Dimensionless ratio expressed per hundred (value multiplied by 100)."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/PERCENT> .

:sample-per-second a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Sample per second"@en ;
    skos:altLabel "samples per second"@en ;
    skos:altLabel "samples/second"@en ;
    skos:definition "Count rate: number of samples processed per second."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/SAMPLE-PER-SEC> .

:second a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Second"@en ;
    skos:altLabel "s"@en ;
    skos:altLabel "seconds"@en ;
    skos:definition "SI base unit of time."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/SEC> .

:unit-unreported a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Unit not reported"@en ;
    skos:altLabel "unknown unit"@en ;
    skos:altLabel "unresolved unit"@en ;
    skos:definition "The source does not state the unit, or the unit could not be resolved. Use only with a keep_detail explanation."@en .

:unitless a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Unitless"@en ;
    skos:altLabel "dimensionless"@en ;
    skos:altLabel "no unit"@en ;
    skos:definition "Explicit marker that the value has no unit: scores, correlations, effect sizes, AUC and similar dimensionless statistics. The quantity itself is given by the metric field."@en ;
    skos:exactMatch <http://qudt.org/vocab/unit/UNITLESS> ;
    skos:scopeNote "A unitless statistic printed x100 (MCC, R2, Spearman, AUC) stays unitless with unit_detail 'printed x100'; percent would imply a proportion."@en .

:variants-per-1000-cases-per-cycle a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Variants per 1000 cases per cycle"@en ;
    skos:definition "Count of variants per 1000 cases in one analysis cycle. The meaning of cycle is not defined in the source string."@en .

:variants-per-diagnosis a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Variants per diagnosis"@en ;
    skos:definition "Count of variants divided by number of (recovered) diagnoses. No QUDT unit keeps this denominator."@en .

:variants-per-proband a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/unit/> ;
    skos:prefLabel "Variants per proband"@en ;
    skos:definition "Count of variants divided by number of probands. No QUDT unit keeps this denominator."@en .
