@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/method-type/> .

<https://benchmarks.rewire.it/vocab/method-type/> a skos:ConceptScheme ;
    skos:prefLabel "Method types"@en ;
    skos:definition "Broad kinds of method or model."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/method-type.csv> .

:conventional_pipeline a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/method-type/> ;
    skos:prefLabel "Conventional pipeline"@en ;
    skos:altLabel "conventional_pipeline"@en ;
    skos:definition "Established non-foundation-model analysis workflow (for example alignment and calling pipelines, mNGS workflows)."@en .

:foundation_model a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/method-type/> ;
    skos:prefLabel "Foundation model"@en ;
    skos:altLabel "foundation model"@en ;
    skos:altLabel "foundation_model"@en ;
    skos:definition "Large model pretrained on broad data and adapted to many downstream tasks."@en .

:specialist a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/method-type/> ;
    skos:prefLabel "Specialist model"@en ;
    skos:altLabel "specialist"@en ;
    skos:definition "Model or tool built for a specific task rather than broad pretraining."@en .

:supervised_machine_learning a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/method-type/> ;
    skos:prefLabel "Supervised machine learning"@en ;
    skos:altLabel "supervised_machine_learning"@en ;
    skos:definition "Task-specific model trained on labelled data. Overlaps specialist-model."@en .
