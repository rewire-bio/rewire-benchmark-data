@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://benchmarks.rewire.it/vocab/licence-family/> .

<https://benchmarks.rewire.it/vocab/licence-family/> a skos:ConceptScheme ;
    skos:prefLabel "Licence families"@en ;
    skos:definition "The licence a source's recorded licence string resolves to, grouped by the redistribution rights it grants. A family is what decides an archive tier; the exact wording and version stay in the licence string the source records."@en ;
    skos:scopeNote "One family per row of data/archive/licence-map.tsv. Versions are not split into separate concepts: no version difference in the store today changes the tier, and the version is readable in the licence string itself."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/archive/licence-map.tsv> .

:cc0 a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC0"@en ;
    skos:altLabel "cc0"@en ;
    skos:definition "Creative Commons public domain dedication. No condition on redistribution."@en .

:cc-by a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY"@en ;
    skos:altLabel "cc-by"@en ;
    skos:definition "Creative Commons Attribution. Redistribution and adaptation are permitted with attribution."@en .

:cc-by-sa a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY-SA"@en ;
    skos:altLabel "cc-by-sa"@en ;
    skos:definition "Creative Commons Attribution-ShareAlike. As CC BY, with adapted material carrying the same licence."@en .

:cc-by-nc a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY-NC"@en ;
    skos:altLabel "cc-by-nc"@en ;
    skos:definition "Creative Commons Attribution-NonCommercial. Redistribution and adaptation are permitted for non-commercial use with attribution."@en .

:cc-by-nc-sa a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY-NC-SA"@en ;
    skos:altLabel "cc-by-nc-sa"@en ;
    skos:definition "Creative Commons Attribution-NonCommercial-ShareAlike. As CC BY-NC, with adapted material carrying the same licence."@en .

:cc-by-nd a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY-ND"@en ;
    skos:altLabel "cc-by-nd"@en ;
    skos:definition "Creative Commons Attribution-NoDerivatives. The verbatim work may be redistributed with attribution; adapted material may not be shared."@en .

:cc-by-nc-nd a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "CC BY-NC-ND"@en ;
    skos:altLabel "cc-by-nc-nd"@en ;
    skos:definition "Creative Commons Attribution-NonCommercial-NoDerivatives. The verbatim work may be redistributed non-commercially with attribution; adapted material may not be shared."@en .

:permissive-code a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "Permissive code licence"@en ;
    skos:altLabel "permissive-code"@en ;
    skos:definition "MIT, Apache-2.0, BSD and the like. Redistribution of the files and of derived work is permitted with the notice the licence requires."@en .

:other-open a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "Other open licence"@en ;
    skos:altLabel "other-open"@en ;
    skos:definition "An open licence outside the Creative Commons and permissive-code sets, or a stated combination of them, that still permits redistribution. ODbL is the case in the store today."@en .

:arxiv-nonexclusive a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "arXiv non-exclusive licence"@en ;
    skos:altLabel "arxiv-nonexclusive"@en ;
    skos:definition "The arXiv.org perpetual non-exclusive licence to distribute. It grants arXiv the right to distribute the work and grants a third party no redistribution right at all."@en .

:publisher-terms a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "Publisher terms"@en ;
    skos:altLabel "publisher-terms"@en ;
    skos:definition "A publisher's own reuse terms, including author-manuscript and bronze open-access arrangements, where no open licence is offered."@en .

:bespoke-restricted a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "Bespoke restricted terms"@en ;
    skos:altLabel "bespoke-restricted"@en ;
    skos:definition "A licence written for one model, dataset or service that restricts redistribution, for example terms of use limited to academic or non-commercial organisations."@en .

:all-rights-reserved a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "All rights reserved"@en ;
    skos:altLabel "all-rights-reserved"@en ;
    skos:definition "The rights holder reserves everything and offers no reuse licence. The bioRxiv and medRxiv cc_no display licence is the common case."@en .

:not-stated a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/licence-family/> ;
    skos:prefLabel "Not stated"@en ;
    skos:altLabel "not-stated"@en ;
    skos:definition "The retrieved source states no licence. A missingness state, not a licence: the work is still under copyright and the tier is private until a resolver finds terms somewhere else."@en .
