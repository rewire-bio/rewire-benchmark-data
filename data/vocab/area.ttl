@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/area/> .

<https://benchmarks.rewire.it/vocab/area/> a skos:ConceptScheme ;
    skos:prefLabel "Research areas"@en ;
    skos:definition "Biological research areas used to browse the catalogue, matched to EDAM topics."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/area.csv> .

:biological-networks a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Biological networks"@en ;
    skos:altLabel "gene regulatory networks"@en ;
    skos:definition "Inference of gene regulatory and other biological networks."@en ;
    skos:closeMatch <http://edamontology.org/topic_0602> .

:cells-tissues a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Cells & tissues"@en ;
    skos:altLabel "cells-spatial-multiomics"@en ;
    skos:definition "Single-cell reference mapping, annotation, integration and perturbation."@en ;
    skos:closeMatch <http://edamontology.org/topic_2229> .

:dna-genomes a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "DNA & genomes"@en ;
    skos:altLabel "DNA"@en ;
    skos:altLabel "genomics"@en ;
    skos:definition "Sequence variation, splicing and gene regulation from DNA sequence."@en ;
    skos:closeMatch <http://edamontology.org/topic_0622> .

:glycans a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Glycans & glycomics"@en ;
    skos:altLabel "glycomics"@en ;
    skos:definition "Glycan structure, taxonomy, immunogenicity and glycosylation prediction."@en ;
    skos:closeMatch <http://edamontology.org/topic_0152> .

:lipidomics a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Lipidomics"@en ;
    skos:definition "Lipid identification and quantification."@en ;
    skos:exactMatch <http://edamontology.org/topic_0153> .

:mechanistic-biology a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Mechanistic biology"@en ;
    skos:altLabel "mechanistic modelling"@en ;
    skos:altLabel "systems biology"@en ;
    skos:definition "Mechanistic and constraint-based models such as flux balance and kinetic parameter estimation."@en ;
    skos:closeMatch <http://edamontology.org/topic_2259> .

:metabolomics a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Metabolomics"@en ;
    skos:altLabel "mass spectrometry"@en ;
    skos:altLabel "small molecules"@en ;
    skos:definition "Small-molecule identification and retrieval, mainly from mass spectra."@en ;
    skos:exactMatch <http://edamontology.org/topic_3172> .

:microbes-communities a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Microbes & communities"@en ;
    skos:altLabel "metagenomics"@en ;
    skos:altLabel "microbiome"@en ;
    skos:definition "Microbial sequences, metagenomic classification and community profiling."@en ;
    skos:closeMatch <http://edamontology.org/topic_3174> .

:molecular-interactions a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Molecular interactions"@en ;
    skos:definition "Docking, binding affinity and multi-molecule structure."@en ;
    skos:closeMatch <http://edamontology.org/topic_0602> .

:protein-function a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Protein function"@en ;
    skos:altLabel "protein fitness"@en ;
    skos:definition "Protein function and fitness prediction. Narrower than proteins-complexes."@en ;
    skos:broader :proteins-complexes ;
    skos:closeMatch <http://edamontology.org/topic_1775> .

:protein-structure a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Protein structure"@en ;
    skos:definition "Protein structure prediction and analysis. Narrower than proteins-complexes."@en ;
    skos:broader :proteins-complexes ;
    skos:exactMatch <http://edamontology.org/topic_2814> .

:proteins-complexes a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Proteins & complexes"@en ;
    skos:altLabel "proteins"@en ;
    skos:definition "Mutation effects, folding, structure, function and design of proteins and protein complexes."@en ;
    skos:closeMatch <http://edamontology.org/topic_0078> .

:rna-transcriptomes a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "RNA & transcriptomes"@en ;
    skos:altLabel "RNA"@en ;
    skos:altLabel "rna-transcriptomics"@en ;
    skos:altLabel "transcriptomics"@en ;
    skos:definition "RNA structure and transcript-level function, including mRNA translation and stability."@en ;
    skos:closeMatch <http://edamontology.org/topic_0099> .

:single-cell a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Single-cell"@en ;
    skos:definition "Single-cell sequencing models and benchmarks. Narrower than cells-tissues."@en ;
    skos:broader :cells-tissues ;
    skos:closeMatch <http://edamontology.org/topic_4028> .

:spatial-omics a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/area/> ;
    skos:prefLabel "Spatial omics"@en ;
    skos:definition "Spatially resolved expression, including prediction from histology. Narrower than cells-tissues. EDAM 1.25 has no spatial omics topic."@en ;
    skos:broader :cells-tissues .
