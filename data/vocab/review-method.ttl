@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/review-method/> .

<https://benchmarks.rewire.it/vocab/review-method/> a skos:ConceptScheme ;
    skos:prefLabel "Review methods"@en ;
    skos:definition "How a record's values were checked."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/review-method.csv> .

:ai-assisted-source-review a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "AI-assisted source review"@en ;
    skos:altLabel "AI table review"@en ;
    skos:altLabel "ai_assisted_source_review"@en ;
    skos:definition "An AI model reads the source and checks values, labels or scope."@en .

:automated-source-review a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Automated source review"@en ;
    skos:altLabel "automated_source_review"@en ;
    skos:definition "Values checked against the primary source by an automated agent; technique not stated."@en .

:deterministic-table-parse a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Deterministic table parse"@en ;
    skos:altLabel "XML/OOXML extraction"@en ;
    skos:altLabel "table extraction"@en ;
    skos:definition "Scripted parse of a structured table or record (HTML, JATS/XML, OOXML/XLSX, TSV, embedded run records)."@en .

:execution-evidence-review a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Execution evidence review"@en ;
    skos:altLabel "automated_execution_evidence_review"@en ;
    skos:definition "Review of run logs, reports and saved outputs from an execution."@en .

:existing-run-import a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Existing run import"@en ;
    skos:altLabel "existing_run_import"@en ;
    skos:definition "Results imported from an existing run record without new review."@en .

:independent-cell-check a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Independent cell check"@en ;
    skos:altLabel "cross-check"@en ;
    skos:definition "A separate check of extracted cells or values against the source or an independent extraction."@en .

:pdf-text-parse a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "PDF text-layer parse"@en ;
    skos:altLabel "pdftotext"@en ;
    skos:definition "Scripted parse of a PDF text layer."@en .

:rendered-source-visual-check a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Rendered source visual check"@en ;
    skos:altLabel "visual PDF verification"@en ;
    skos:definition "Values compared by eye with the rendered PDF or page."@en .

:scope-review a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Scope review"@en ;
    skos:altLabel "metric and scope check"@en ;
    skos:definition "Check of metric definitions, captions, methods text and evaluation scope."@en .

:source-hash-verification a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Source hash verification"@en ;
    skos:altLabel "git blob inspection"@en ;
    skos:definition "Check that the reviewed artifact matches a pinned hash or blob."@en .

:source-data-recomputation a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Source data recomputation"@en ;
    skos:definition "A derived value checked by re-downloading each input, confirming its SHA-256 and row count, rerunning the pinned script and comparing its output with the stored value."@en .

:transcription a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/review-method/> ;
    skos:prefLabel "Transcription"@en ;
    skos:altLabel "exact-string transcription"@en ;
    skos:altLabel "manual transcription"@en ;
    skos:definition "Printed values copied from a source by a person or AI agent rather than by a deterministic parser."@en .
