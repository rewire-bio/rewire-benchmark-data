@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <https://benchmarks.rewire.it/vocab/status/> .

<https://benchmarks.rewire.it/vocab/status/> a skos:ConceptScheme ;
    skos:prefLabel "Record status"@en ;
    skos:definition "How far a record has been checked. Source-checked is not reproduced."@en .

:discovered a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Discovered"@en ;
    skos:definition "Found in a search; not yet checked against its source."@en .

:needs_review a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Needs review"@en ;
    skos:definition "Extracted, with a known question that a review must settle."@en .

:source_checked a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Source checked"@en ;
    skos:definition "Checked against the cited source; not independently reproduced."@en .

:reproduced a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Reproduced"@en ;
    skos:definition "Reproduced by a Rewire run."@en .

:disputed a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Disputed"@en ;
    skos:definition "Contradicted by other evidence; withheld from comparisons."@en .

:superseded a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Superseded"@en ;
    skos:definition "Replaced by a newer record."@en .

:excluded a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/status/> ;
    skos:prefLabel "Excluded"@en ;
    skos:definition "Kept in the archive but never published."@en .
