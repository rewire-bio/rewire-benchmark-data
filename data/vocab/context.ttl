@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/context/> .

<https://benchmarks.rewire.it/vocab/context/> a skos:ConceptScheme ;
    skos:prefLabel "Use contexts"@en ;
    skos:definition "Settings a record is relevant to."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/context.csv> .

:clinical_research a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/context/> ;
    skos:prefLabel "Clinical research"@en ;
    skos:altLabel "clinical_research"@en ;
    skos:definition "Record concerns clinical or diagnostic use (variant interpretation, oncology, pathogen detection)."@en .

:research a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/context/> ;
    skos:prefLabel "Research"@en ;
    skos:altLabel "research"@en ;
    skos:definition "Record concerns research use without a clinical or diagnostic decision, such as experiment design or method selection."@en .
