@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/baseline-type/> .

<https://benchmarks.rewire.it/vocab/baseline-type/> a skos:ConceptScheme ;
    skos:prefLabel "Baseline types"@en ;
    skos:definition "Kinds of baseline or comparator."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/baseline-type.csv> .

:classical_procedure a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Classical computational procedure"@en ;
    skos:altLabel "biological-procedure"@en ;
    skos:definition "A non-learned algorithmic procedure (docking, homology search, MFE folding, library matching)."@en .

:conventional_workflow a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Conventional workflow"@en ;
    skos:altLabel "conventional_workflow"@en ;
    skos:definition "The current standard practice workflow, including manual or tool-assisted lookup."@en .

:established_method a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Established method"@en ;
    skos:altLabel "established_method"@en ;
    skos:definition "A published, named method or trained model used as a comparator."@en .

:evolutionary_model a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Evolutionary model"@en ;
    skos:altLabel "evolutionary_model"@en ;
    skos:definition "Model fitted to evolutionary sequence data (site-independent, EVmutation)."@en .

:experimental_reference a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Experimental reference"@en ;
    skos:altLabel "experimental-reference"@en ;
    skos:definition "Experimental ceiling such as replicate agreement."@en .

:learned_specialist a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Learned specialist"@en ;
    skos:altLabel "learned-specialist"@en ;
    skos:definition "Task-specific trained model used as a comparator."@en .

:mechanistic a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Mechanistic model"@en ;
    skos:altLabel "mechanistic"@en ;
    skos:definition "Mechanistic or constraint-based model such as flux balance."@en .

:null_control a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Null control"@en ;
    skos:altLabel "null-control"@en ;
    skos:altLabel "null_control"@en ;
    skos:definition "No-information control: training mean, class prior, shuffled input, random network, no change."@en .

:simple_statistical a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/baseline-type/> ;
    skos:prefLabel "Simple statistical or classical ML model"@en ;
    skos:altLabel "simple-statistical"@en ;
    skos:definition "Linear, regularised-linear or tree-ensemble model on hand-made features such as k-mer counts, composition, GC content, motifs or position. The algorithm is recorded in baseline_algorithm."@en .
