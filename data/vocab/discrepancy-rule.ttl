@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix : <https://benchmarks.rewire.it/vocab/discrepancy-rule/> .

<https://benchmarks.rewire.it/vocab/discrepancy-rule/> a skos:ConceptScheme ;
    skos:prefLabel "Discrepancy rules"@en ;
    skos:definition "The rules the knowledge-graph build uses to find results from one source that disagree with results from other sources. Thresholds are in data/ontology/discrepancy-rules.json."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/docs/linked-data.md> .

:ordering-reversal a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-rule/> ;
    skos:prefLabel "Ordering reversal"@en ;
    skos:definition "Other independent sources consistently rank one system above another; this source consistently ranks them the other way round."@en ;
    skos:closeMatch obo:STATO_0000118 .

:gap-outlier a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/discrepancy-rule/> ;
    skos:prefLabel "Gap outlier"@en ;
    skos:definition "This source's relative difference between a system and a shared reference system falls outside the range the other sources report, by more than a set margin."@en ;
    skos:closeMatch obo:STATO_0000615 .
