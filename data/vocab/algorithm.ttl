@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <https://benchmarks.rewire.it/vocab/algorithm/> .

<https://benchmarks.rewire.it/vocab/algorithm/> a skos:ConceptScheme ;
    skos:prefLabel "Model algorithms"@en ;
    skos:definition "The learning algorithm behind a simple statistical baseline. The baseline's role is in baseline_type."@en .

:gradient_boosted_trees a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/algorithm/> ;
    skos:prefLabel "Gradient-boosted trees"@en ;
    skos:definition "Additive ensemble of decision trees fitted stagewise to the gradient of a loss (Friedman 2001, Ann Stat 29:1189, doi:10.1214/aos/1013203451)."@en .

:linear_regression a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/algorithm/> ;
    skos:prefLabel "Linear regression"@en ;
    skos:definition "Model of a continuous response as a linear function of features, fitted by least squares."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000108> .

:random_forest a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/algorithm/> ;
    skos:prefLabel "Random forest"@en ;
    skos:definition "Ensemble of decision trees fitted on bootstrap samples with random feature subsets; prediction by averaging or voting."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000549> .

:ridge_regression a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/algorithm/> ;
    skos:prefLabel "Ridge regression"@en ;
    skos:definition "Linear regression with an L2 penalty on coefficients (Hoerl and Kennard 1970, Technometrics 12:55, doi:10.1080/00401706.1970.10488634)."@en .
