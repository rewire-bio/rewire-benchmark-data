@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/configuration-type/> .

<https://benchmarks.rewire.it/vocab/configuration-type/> a skos:ConceptScheme ;
    skos:prefLabel "Configuration types"@en ;
    skos:definition "How a configuration record was established."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/configuration-type.csv> .

:paper_evaluation a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/configuration-type/> ;
    skos:prefLabel "Paper-evaluated configuration"@en ;
    skos:altLabel "paper_evaluation"@en ;
    skos:definition "A configuration of the paper's own method evaluated in that paper."@en .

:pipeline a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/configuration-type/> ;
    skos:prefLabel "Pipeline"@en ;
    skos:definition "A multi-step pipeline. Redundant with the pipeline record kind."@en .

:reported_configuration a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/configuration-type/> ;
    skos:prefLabel "Reported configuration"@en ;
    skos:altLabel "reported_configuration"@en ;
    skos:definition "A configuration (checkpoint, settings, inputs) as reported in a source, typically a comparator."@en .
