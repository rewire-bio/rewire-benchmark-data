@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <https://benchmarks.rewire.it/vocab/uncertainty-type/> .

<https://benchmarks.rewire.it/vocab/uncertainty-type/> a skos:ConceptScheme ;
    skos:prefLabel "Uncertainty types"@en ;
    skos:definition "What a result's reported spread or interval is. A spread whose meaning the source does not establish is unresolved, never assumed."@en .

:standard_deviation a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/uncertainty-type/> ;
    skos:prefLabel "Standard deviation"@en ;
    skos:definition "The standard deviation of the scores behind the result, for example over seeds, splits or bootstrap resamples."@en .

:standard_error a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/uncertainty-type/> ;
    skos:prefLabel "Standard error"@en ;
    skos:definition "The standard error of the reported estimate, measured or propagated."@en .

:confidence_interval a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/uncertainty-type/> ;
    skos:prefLabel "Confidence interval"@en ;
    skos:definition "An interval at a stated confidence level, given as bounds or as a half-width around the result."@en .

:credible_interval a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/uncertainty-type/> ;
    skos:prefLabel "Credible interval"@en ;
    skos:definition "A Bayesian interval at a stated probability."@en .

:unresolved_spread a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/uncertainty-type/> ;
    skos:prefLabel "Unresolved spread"@en ;
    skos:definition "A printed plus-or-minus spread whose type the source does not establish. Never plotted as an interval."@en .
