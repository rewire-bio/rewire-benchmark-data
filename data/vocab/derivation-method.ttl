@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <https://benchmarks.rewire.it/vocab/derivation-method/> .

<https://benchmarks.rewire.it/vocab/derivation-method/> a skos:ConceptScheme ;
    skos:prefLabel "Derivation methods"@en ;
    skos:definition "How Rewire obtained a result value that the source does not print. A result without a derivation holds the value exactly as the source prints it."@en .

:computed-from-source-data a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/derivation-method/> ;
    skos:prefLabel "Computed from the source's own data"@en ;
    skos:definition "Computed by Rewire with a pinned script from per-item rows in the source's own supplementary data (for example a Source Data workbook), using the aggregation the source states. Never from a third party's reanalysis, and never from figure pixels."@en .
