@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/publication-status/> .

<https://benchmarks.rewire.it/vocab/publication-status/> a skos:ConceptScheme ;
    skos:prefLabel "Publication status"@en ;
    skos:definition "Publication status of a source."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/publication-status.csv> .

:official_project_source a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/publication-status/> ;
    skos:prefLabel "Official project source"@en ;
    skos:altLabel "official_project_source"@en ;
    skos:definition "Official project page, documentation, repository or model card; not a scholarly publication."@en .

:peer_reviewed a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/publication-status/> ;
    skos:prefLabel "Peer reviewed"@en ;
    skos:altLabel "peer_reviewed"@en ;
    skos:altLabel "published"@en ;
    skos:definition "Published in a peer-reviewed journal or proceedings."@en .

:preprint a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/publication-status/> ;
    skos:prefLabel "Preprint"@en ;
    skos:altLabel "preprint_not_peer_reviewed"@en ;
    skos:definition "Publicly posted manuscript not yet peer reviewed (bioRxiv, medRxiv, arXiv)."@en .
