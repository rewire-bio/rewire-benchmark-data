@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/agent/> .

<https://benchmarks.rewire.it/vocab/agent/> a skos:ConceptScheme ;
    skos:prefLabel "Agents"@en ;
    skos:definition "People, AI models and software that extracted or reviewed records."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/agent.csv> .

:claude a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Claude (model unspecified)"@en ;
    skos:definition "Anthropic Claude, model and version not recorded."@en ;
    skos:scopeNote "AI model"@en .

:claude-sonnet a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Claude Sonnet"@en ;
    skos:definition "Anthropic Claude Sonnet acting as worker or reviewer. Model version not recorded."@en ;
    skos:scopeNote "AI model"@en .

:codex a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Codex"@en ;
    skos:altLabel "OpenAI Codex"@en ;
    skos:definition "OpenAI Codex coding agent acting as curator or reviewer. Model version not recorded."@en ;
    skos:scopeNote "AI model"@en .

:rewire-benchmark-runner a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Rewire benchmark runner"@en ;
    skos:definition "Rewire benchmark execution, recorded as the reviewer of its own output."@en ;
    skos:scopeNote "Software"@en .

:rewire-deterministic-table-checker a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Rewire deterministic table checker"@en ;
    skos:definition "Rewire script that checks parsed table values deterministically."@en ;
    skos:scopeNote "Software"@en .

:unidentified-automated-reviewer a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/agent/> ;
    skos:prefLabel "Unidentified automated reviewer"@en ;
    skos:definition "An automated reviewer whose agent is not named; the string describes a method instead."@en ;
    skos:scopeNote "unknown"@en .
