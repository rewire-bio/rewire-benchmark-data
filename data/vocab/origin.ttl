@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rb: <https://benchmarks.rewire.it/vocab#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix : <https://benchmarks.rewire.it/vocab/origin/> .

<https://benchmarks.rewire.it/vocab/origin/> a skos:ConceptScheme ;
    skos:prefLabel "Evaluation origins"@en ;
    skos:definition "Who reported an evaluation."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/origin.csv> .

:author_reported a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/origin/> ;
    skos:prefLabel "Author reported"@en ;
    skos:altLabel "author_reported"@en ;
    skos:definition "Result reported by the authors of the evaluated method."@en .

:independent_paper a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/origin/> ;
    skos:prefLabel "Independent paper"@en ;
    skos:altLabel "independent_paper"@en ;
    skos:definition "Result reported in a paper by authors independent of the evaluated method."@en .

:paper_compilation a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/origin/> ;
    skos:prefLabel "Paper compilation"@en ;
    skos:altLabel "paper_compilation"@en ;
    skos:definition "Result copied into a review, leaderboard or compilation from earlier papers."@en .

:rewire_run a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/origin/> ;
    skos:prefLabel "Rewire run"@en ;
    skos:altLabel "rewire_run"@en ;
    skos:definition "Result produced by a Rewire benchmark execution."@en .

:unreported a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/origin/> ;
    skos:prefLabel "Origin unreported"@en ;
    skos:definition "Origin not stated. A missingness state, not an origin."@en .
