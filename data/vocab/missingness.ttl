@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://benchmarks.rewire.it/vocab/missingness/> .

<https://benchmarks.rewire.it/vocab/missingness/> a skos:ConceptScheme ;
    skos:prefLabel "Missing-value reasons"@en ;
    skos:definition "Why a record has no value for a declared field. Every field is either present or listed in the record's missing_metadata with one of these reasons."@en ;
    dcterms:source <https://github.com/rewire-bio/rewire-benchmark-data/blob/main/data/vocab/migration/missingness.csv> .

:unreported a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/missingness/> ;
    skos:prefLabel "Unreported"@en ;
    skos:definition "The inspected source does not state the value."@en .

:unextracted a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/missingness/> ;
    skos:prefLabel "Unextracted"@en ;
    skos:definition "The value may be stated in a source but has not been recorded. Not a claim that the source omits it."@en .

:unavailable a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/missingness/> ;
    skos:prefLabel "Unavailable"@en ;
    skos:definition "The source holding the value is unpublished or could not be accessed."@en .

:inapplicable a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/missingness/> ;
    skos:prefLabel "Inapplicable"@en ;
    skos:definition "The field does not apply to this record, for example an uncertainty for a single run."@en .

:conflicting a skos:Concept ;
    skos:inScheme <https://benchmarks.rewire.it/vocab/missingness/> ;
    skos:prefLabel "Conflicting"@en ;
    skos:definition "Sources state different values and the record does not choose between them."@en .
