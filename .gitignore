node_modules
/public/
workbench/
*.tsbuildinfo
__pycache__/
*.pyc
.env*
*-debug.log
.DS_Store

/maintenance/.refresh.lock
/maintenance/**/*.tmp-*

# Release files are build output, published as assets of the serving/<id> GitHub release
# (scripts/release/files.ts). The receipts data/omics/releases/<id>.json and
# website/manifest.json stay committed.
/data/omics/releases/*/
/website/files/

# Archive object cache: the source bytes the fetcher holds locally
# (scripts/archive/). Keys are content addressed, so nothing here is unique to
# a clone, and no source bytes enter git. The manifest that does enter git,
# data/archive/objects/<0-f>.jsonl, is text only.
/data/archive/cache/
