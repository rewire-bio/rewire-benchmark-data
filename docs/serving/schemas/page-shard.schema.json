{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "shard": {
      "type": "string"
    },
    "pages": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "route_kind": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "canonical_route": {
            "type": "string"
          },
          "record": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "direct": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relation": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "relation",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "reverse": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relation": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "relation",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "results": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "evaluations": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "evidence_rows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "published_comparisons": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "use_case_links": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "results",
              "evaluations",
              "evidence_rows",
              "published_comparisons",
              "use_case_links"
            ],
            "additionalProperties": false
          },
          "sections": {
            "type": "object",
            "properties": {
              "results": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "evaluation_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "origin": {
                          "type": "string"
                        },
                        "review_status": {
                          "type": "string"
                        },
                        "links": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "required": [
                        "result",
                        "evaluation_id",
                        "origin",
                        "review_status",
                        "links"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "items",
                  "total",
                  "limit",
                  "next_cursor"
                ],
                "additionalProperties": false
              },
              "evaluations": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "items",
                  "total",
                  "limit",
                  "next_cursor"
                ],
                "additionalProperties": false
              },
              "published_comparisons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "use_case_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "results",
              "evaluations",
              "evidence",
              "published_comparisons",
              "use_case_links"
            ],
            "additionalProperties": false
          },
          "references": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "name",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "route_kind",
          "record_id",
          "canonical_route",
          "record",
          "direct",
          "reverse",
          "source_ids",
          "summary",
          "sections",
          "references"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "release_id",
    "artifact_schema_version",
    "shard",
    "pages"
  ],
  "additionalProperties": false
}
