{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "route_kind": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "route_kind": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "canonical_route": {
            "type": "string"
          },
          "alias": {
            "type": "boolean"
          },
          "page_shard": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "route",
          "route_kind",
          "record_id",
          "canonical_route",
          "alias",
          "page_shard",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "release_id",
    "artifact_schema_version",
    "route_kind",
    "routes"
  ],
  "additionalProperties": false
}
