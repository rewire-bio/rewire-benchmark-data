{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "serving_contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_schema_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{12}$"
    },
    "released_at": {
      "type": "string"
    },
    "catalogue_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generator_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "bootstrap",
          "routes",
          "pages",
          "browse",
          "search",
          "supporting",
          "downloads"
        ]
      },
      "additionalProperties": {
        "type": "boolean"
      },
      "required": [
        "bootstrap",
        "routes",
        "pages",
        "browse",
        "search",
        "supporting",
        "downloads"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "records_by_kind": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "routes_by_kind": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "alias_routes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "records_by_kind",
        "routes_by_kind",
        "alias_routes",
        "pages"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"
          },
          "group": {
            "type": "string",
            "enum": [
              "bootstrap",
              "routes",
              "pages",
              "browse",
              "search",
              "supporting",
              "downloads"
            ]
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "artifact_schema_version": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "identity",
              "gzip"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stored_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stored_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source",
          "group",
          "artifact_type",
          "artifact_schema_version",
          "encoding",
          "bytes",
          "sha256",
          "stored_bytes",
          "stored_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "serving_contract_version",
    "record_schema_version",
    "release_id",
    "released_at",
    "catalogue_sha256",
    "generator_sha256",
    "capabilities",
    "counts",
    "files"
  ],
  "additionalProperties": false
}
