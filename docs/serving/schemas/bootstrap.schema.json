{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string"
    },
    "released_at": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "counts": {
      "type": "object",
      "properties": {
        "records_by_kind": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "results_by_review_status": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "evaluations_by_origin": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "records_by_kind",
        "results_by_review_status",
        "evaluations_by_origin"
      ],
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "release_id",
    "released_at",
    "artifact_schema_version",
    "counts",
    "facets"
  ],
  "additionalProperties": false
}
