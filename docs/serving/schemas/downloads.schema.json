{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "url_template": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "archive_path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "sha256",
          "archive_path"
        ],
        "additionalProperties": false
      }
    },
    "historical_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "release_id",
    "artifact_schema_version",
    "url_template",
    "files",
    "historical_receipts"
  ],
  "additionalProperties": false
}
